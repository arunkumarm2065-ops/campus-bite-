rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc().active == true;
    }
    function isAdmin() {
      return isActiveUser() && userDoc().role == 'admin';
    }

    function isStudent() { return isActiveUser() && userDoc().role == 'student'; }

    // ---- Campus Wallet -------------------------------------------------------
    // DEMO SWITCH: there is no payment gateway, so students may top up their own wallet for
    // testing (max 2000 per top-up, 5000 balance). Change this to `false` for real use and also
    // set ALLOW_STUDENT_TOPUP = false in wallet.js: then only admins can add money.
    function demoTopUpAllowed() { return true; }

    match /wallets/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (
        isStudent() && request.auth.uid == uid &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.balance >= 0 &&
        (request.resource.data.balance == 0 || (demoTopUpAllowed() && request.resource.data.balance <= 2000))
      );
      allow update: if isAdmin() || (
        isStudent() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt', 'studentName']) &&
        request.resource.data.balance >= 0 &&
        request.resource.data.balance <= 5000 &&
        (
          request.resource.data.balance <= resource.data.balance ||                       // paying for an order
          (demoTopUpAllowed() && request.resource.data.balance - resource.data.balance <= 2000)  // demo top-up
        )
      );
      allow delete: if isAdmin();
    }

    // Immutable ledger: lines can be added but never edited or deleted from the app.
    match /walletTxns/{txnId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (
        isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type in ['topup', 'payment'] &&
        (request.resource.data.type == 'payment' || demoTopUpAllowed()) &&
        // the ledger line must match the wallet balance written in the same transaction
        getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.balance == request.resource.data.balanceAfter
      );
      allow update, delete: if false;
    }


    // ---- Milestone rewards (admin controls them; claims are written only by the claimReward Cloud Function) ----
    match /rewardMilestones/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /rewardClaims/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---- Monthly sales report e-mail (settings by admin; logs written only by Cloud Functions) ----
    match /reportSettings/{shopId} {
      allow read, write: if isAdmin();
    }
    match /reportLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Chatbot (admin turns it on/off, picks the icon and teaches answers; everyone signed in can read) ----
    match /chatbotConfig/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.get('icon', '') is string &&
        request.resource.data.get('icon', '').size() <= 60000;
      allow delete: if isAdmin();
    }
    match /chatbotTraining/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.reply is string && request.resource.data.reply.size() <= 1000 &&
        request.resource.data.triggers is list && request.resource.data.triggers.size() <= 20;
      allow delete: if isAdmin();
    }
    // Questions the bot could not answer: any signed-in user may add/increase the counter, only admins read or clear them.
    match /chatbotUnanswered/{id} {
      allow read, delete: if isAdmin();
      allow create: if isActiveUser() &&
        request.resource.data.keys().hasOnly(['text', 'count', 'lastAt']) &&
        request.resource.data.text is string && request.resource.data.text.size() <= 120 &&
        request.resource.data.count == 1;
      allow update: if isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastAt']) &&
        request.resource.data.count == resource.data.count + 1;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'username', 'email', 'shopName', 'shopId', 'className', 'updatedAt']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        (resource.data.role != 'owner' || request.resource.data.shopId == resource.data.shopId)
      );
      allow delete: if isAdmin();
    }

    match /campusbite/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      function orderBelongsToStudent() {
        return isActiveUser() &&
          userDoc().role == 'student' &&
          resource.data.studentId == request.auth.uid;
      }
      function orderBelongsToOwnerShop() {
        return isActiveUser() &&
          userDoc().role == 'owner' &&
          (
            resource.data.get('ownerId', '') == request.auth.uid ||
            (
              userDoc().get('shopId', '') != '' &&
              userDoc().get('shopId', '') == resource.data.get('shopId', '')
            )
          );
      }
      function ownerCanUpdateOrder() {
        return orderBelongsToOwnerShop() && (
          (
            resource.data.status == 'Preparing' &&
            request.resource.data.status == 'Ready' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'counter', 'updatedAt'])
          ) ||
          (
            resource.data.status == 'Ready' &&
            request.resource.data.status == 'Completed' &&
            request.resource.data.completedBy == request.auth.uid &&
            request.resource.data.completedByRole == 'owner' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'completedAt', 'completedBy', 'completedByRole', 'updatedAt'])
          ) ||
          (
            !(resource.data.status in ['Cancelled', 'Refunded']) &&
            request.resource.data.status == 'Cancelled' &&
            request.resource.data.cancelledBy == request.auth.uid &&
            request.resource.data.cancelledByRole == 'owner' &&
            request.resource.data.stockRestored == true &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelReason', 'cancelledBy', 'cancelledByRole', 'cancelledAt', 'updatedAt', 'stockRestored'])
          )
        );
      }
      allow read: if orderBelongsToStudent() || orderBelongsToOwnerShop() || isAdmin();
      allow create: if isActiveUser() &&
        userDoc().role == 'student' &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'Preparing';
      allow update: if isAdmin() || ownerCanUpdateOrder();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
