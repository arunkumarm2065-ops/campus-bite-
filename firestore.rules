rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /campusbite/{document} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
